# vscode
.vscode 

# Intellij
*.iml
.idea

# npm
node_modules

# Don't include the compiled main.js file in the repo.
# They should be uploaded to GitHub releases instead.
main.js

# Exclude sourcemaps
*.map

# E2E test environment (specs/002-e2e-test-env)
# Build artifact installed into the test vault by `npm run e2e:setup` — never committed
test-vault/.obsidian/plugins/obsidian-usm-plugin/main.js
# Obsidian runtime/working files created when the test vault is opened — never committed
test-vault/.obsidian/app.json
test-vault/.obsidian/appearance.json
test-vault/.obsidian/core-plugins.json
test-vault/.obsidian/workspace.json
test-vault/.obsidian/workspace-mobile.json
test-vault/.obsidian/hotkeys.json
test-vault/.obsidian/graph.json
# Generated verification output (screenshots, JSON reports)
e2e/output/

# obsidian
data.json

# Exclude macOS Finder (System Explorer) View States
.DS_Store
